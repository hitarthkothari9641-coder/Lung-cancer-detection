# Backend Configuration
PORT=8000
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:3000
DATA_DIR=./data
ARTIFACTS_DIR=./artifacts
LABEL_SOURCE=proxy
MOCK_MODE=false

# Frontend Configuration
# Leave NEXT_PUBLIC_API_URL empty to use the built-in /api proxy (recommended).
# Set it only to call a backend on a different host.
NEXT_PUBLIC_API_URL=
BACKEND_URL=http://127.0.0.1:8000
